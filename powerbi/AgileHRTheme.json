{
  "name": "Agile HR Copilot",
  "dataColors": [
    "#1F3A5F",
    "#F0B429",
    "#546E7A",
    "#2E7D32",
    "#D93025",
    "#2A4D7A",
    "#9AA8BD",
    "#C9D3E2"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F3A5F",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D32",
  "neutral": "#546E7A",
  "bad": "#D93025",
  "maximum": "#1F3A5F",
  "center": "#9AA8BD",
  "minimum": "#F7F9FC",
  "null": "#EEF1F6",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#1F3A5F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F3A5F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#546E7A"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#1F3A5F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5EAF2" } },
            "radius": 12
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 14,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#546E7A" } },
            "fontSize": 10,
            "gridlineColor": { "solid": { "color": "#EEF1F6" } },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": { "solid": { "color": "#546E7A" } },
            "fontSize": 10,
            "gridlineColor": { "solid": { "color": "#EEF1F6" } },
            "gridlineShow": true
          }
        ],
        "legend": [
          {
            "labelColor": { "solid": { "color": "#546E7A" } },
            "fontSize": 10,
            "position": "TopRight"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#546E7A" } },
            "fontSize": 11
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineStyle": "solid",
            "showMarker": false
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#1F3A5F" } } }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          { "defaultColor": { "solid": { "color": "#1F3A5F" } } }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontalColor": { "solid": { "color": "#EEF1F6" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
        ]
      }
    }
  }
}
